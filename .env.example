# Django Secret Key (generate a secure key for production)
SECRET_KEY=django-insecure-change-this-in-production-prep-tracker-jwt-2026

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated list, e.g. .onrender.com,localhost,127.0.0.1)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database URL:
# For local SQLite: leave blank or set to sqlite:///db.sqlite3
# For PostgreSQL (e.g. Render): postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=
